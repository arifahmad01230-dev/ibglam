var svc=document.querySelector("#bsvc input:checked").value,date=$("bdate").value,time=$("btime").value,name=$("bname").value.trim(),phone=$("bphone").value.trim(),loc=$("bloc").value.trim(),note=$("bnote").value.trim();
if(!date)return fail("berr","Choose your preferred date.");
if(!name)return fail("berr","Enter your full name.");
if(digits(phone).length<10)return fail("berr","Enter a valid WhatsApp number.");
if(!loc)return fail("berr","Enter the location of the session.");
var b={phone:digits(phone).slice(-10),name:name,summary:svc+" on "+date+", "+time+", at "+loc+"."+(note?" Look: "+note:""),stages:BST,stage:0,at:Date.now()};
submit("booking",{name:name,phone:phone,service:svc,date:date,time:time,location:loc,note:note,website:""},b,"IBK","berr",function(ref){
var msg="Hello ibglam, I would like to book a makeup appointment. Reference: "+ref+". Name: "+name+". Service: "+svc+". Date: "+date+", "+time+". Location: "+loc+"."+(note?" Look: "+note:"");
$("bref").textContent=ref;$("bwa").href="https://wa.me/"+WA+"?text="+encodeURIComponent(msg);
$("bform").hidden=true;$("bdone").hidden=false;window.scrollTo(0,0)});
});
/* track */
var OS=["received","confirmed","packed","out_for_delivery","delivered"],BS=["received","confirmed","deposit_agreed","completed"];
function showRes(o){var S=o.stages||STAGES;$("rref").textContent=o.ref;$("rstat").textContent=o.cancelled?"Cancelled":S[o.stage];
$("ritems").textContent=o.summary||((o.cats.length?o.cats.join(", ")+". ":"")+o.items).trim();
var tl=$("rtl");tl.textContent="";S.forEach(function(s,i){tl.appendChild(mk("li",!o.cancelled&&i<=o.stage?"on":"",s))});
$("rwa").href="https://wa.me/"+WA+"?text="+encodeURIComponent("Hello ibglam, I would like an update on my order or booking. Reference: "+o.ref+".");
$("res").hidden=false}
$("tform").addEventListener("submit",function(e){e.preventDefault();$("terr").hidden=true;$("res").hidden=true;
var ref=$("tref").value.trim().toUpperCase(),ph=digits($("tphone").value).slice(-10);
if(!ref||ph.length<10)return fail("terr","Enter your reference and WhatsApp number.");
$("rwa").href="https://wa.me/"+WA+"?text="+encodeURIComponent("Hello ibglam, please help me find my order. Reference: "+ref+".");
var miss="We could not find that reference with that number. Check your details, or message us on WhatsApp.";
if(!API){var o=(store()||[]).concat(bstore()||[]).filter(function(x){return x.ref===ref&&x.phone===ph})[0];return o?showRes(o):fail("terr",miss)}
call("ibglam-track",{reference:ref,phone:ph}).then(function(r){
if(!r.ok)return fail("terr",r.d.error||miss);
var d=r.d,bk=d.kind==="booking",L=bk?BST:STAGES,K=bk?BS:OS;
showRes({ref:d.reference,stages:L,stage:Math.max(0,K.indexOf(d.status)),summary:d.summary,cancelled:d.status==="cancelled"})
}).catch(function(){fail("terr","We could not reach the server. Please try again.")})});
})();
</script>
